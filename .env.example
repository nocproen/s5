# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- 隧道服务（随 Next.js 一起启动，见 src/instrumentation.ts）----
# WebSocket 路径，建议改成随机字符串，例如 /a8f3k2
# 隧道同时挂在网站端口（3000）与独立端口（TUNNEL_PORT）上
TUNNEL_PATH=/tunnel
# 独立隧道端口（可选，设为 0 关闭；整站反代到 3000 时不需要）
TUNNEL_PORT=8080
# 设为 true 可完全关闭隧道服务（例如只想跑网站）
# TUNNEL_DISABLED=true
# 允许代理访问服务器本机回环地址（仅调试用）
# TUNNEL_ALLOW_LOCALHOST=true

# ---- 默认节点 ----
# 不设置时，首次启动会创建一个 host=auto 的节点：自动跟随用户访问本站的网址
# 设置后首次启动会创建固定域名节点
# TUNNEL_PUBLIC_HOST=your.domain.com
# TUNNEL_PUBLIC_PORT=443
# TUNNEL_PUBLIC_TLS=true
# TUNNEL_PUBLIC_NAME=默认节点

# ---- 节点健康检测（后台「节点管理」可手动触发，也会自动定时执行）----
# 自动检测间隔（分钟），0 关闭
NODE_CHECK_INTERVAL_MIN=10
# 检测时经节点访问的外网目标（host:port，HTTP 服务）
NODE_CHECK_TARGET=cp.cloudflare.com:80
# 单次检测超时（毫秒）
# NODE_CHECK_TIMEOUT_MS=12000

# ---- 后台管理员（与前台用户完全独立，登录入口 /admin/login）----
# 首次启动时创建；不设置 ADMIN_PASSWORD 则使用默认密码 admin123456，并在后台提示修改
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=请设置一个强密码
# 关闭前台注册（只允许管理员手动开通）
# REGISTRATION_DISABLED=true

# ---- 网站 ----
# 用于生成订阅链接 / auto 节点的公网地址（不填则根据请求 Host 自动推断）
# NEXT_PUBLIC_SITE_URL=https://your.domain.com
# 新用户默认流量配额（字节），默认 50 GiB
DEFAULT_QUOTA_BYTES=53687091200
# 非 HTTPS 部署时设为 false，否则登录 Cookie 无法写入
# COOKIE_SECURE=false
